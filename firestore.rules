rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && profile().disabled == false; }
    function admin() { return active() && profile().role == 'admin'; }
    function owner(data) { return active() && profile().role == 'landlord' && data.ownerUid == request.auth.uid; }
    function tenant(data) { return active() && profile().role == 'tenant' && profile().tenantId in data.tenantIds; }
    function ownsProperty(id) { return owner(getAfter(/databases/$(database)/documents/rental_properties/$(id)).data); }
    function sameEnvelope() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']) &&
        request.resource.data.archived == false;
    }
    function validPhoneContact(data) {
      return (!data.keys().hasAny(['phoneNumber']) ||
          (data.phoneNumber is string && data.phoneNumber.matches('^\\+84[35789][0-9]{8}$'))) &&
        (!data.keys().hasAny(['phoneIsSynthetic']) || data.phoneIsSynthetic == false) &&
        (!data.keys().hasAny(['phoneVerified']) ||
          (data.phoneVerified is bool &&
            (data.phoneVerified == false ||
              data.phoneNumber == request.auth.token.get('phone_number', ''))));
    }
    function tenantContactOwner(code) {
      return active() && profile().role == 'tenant' && profile().tenantId == code;
    }
    function validTenantContact(data) {
      return data.keys().hasOnly(['displayName', 'phoneNumber']) &&
        data.keys().hasAll(['displayName', 'phoneNumber']) &&
        data.displayName == profile().displayName &&
        data.phoneNumber ==
          (profile().keys().hasAny(['phoneNumber']) ? profile().phoneNumber : '');
    }
    function validTenantCode(code) {
      return code is string && code.matches('^[A-Z0-9]{8}$');
    }
    match /users/{uid} {
      // Users can read their own role record to distinguish pending/disabled accounts.
      allow read: if request.auth != null &&
        (uid == request.auth.uid || admin());
      // Users can self-register only as landlord or tenant. Admin can never be
      // assigned by a client; tenant codes are reserved atomically on creation.
      allow create: if request.auth != null && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'disabled', 'tenantId', 'createdAt',
          'phoneNumber', 'phoneVerified', 'phoneIsSynthetic'
        ]) &&
        request.resource.data.keys().hasAll([
          'email', 'displayName', 'role', 'disabled', 'createdAt'
        ]) &&
        request.resource.data.email == request.auth.token.get('email', '') &&
        validPhoneContact(request.resource.data) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.role in ['landlord', 'tenant'] &&
        request.resource.data.disabled == false &&
        request.resource.data.createdAt == request.time &&
        ((request.resource.data.role == 'tenant' &&
            validTenantCode(request.resource.data.tenantId) &&
            !exists(/databases/$(database)/documents/tenant_codes/$(request.resource.data.tenantId)) &&
            existsAfter(/databases/$(database)/documents/tenant_codes/$(request.resource.data.tenantId)) &&
            getAfter(/databases/$(database)/documents/tenant_codes/$(request.resource.data.tenantId)).data.createdAt == request.time) ||
          (request.resource.data.role == 'landlord' &&
            !request.resource.data.keys().hasAny(['tenantId'])));
      allow delete: if false;
      allow update: if (admin() && uid != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']) &&
          request.resource.data.disabled is bool) ||
        (active() && uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phoneNumber', 'phoneVerified', 'phoneIsSynthetic'
          ]) && validPhoneContact(request.resource.data) &&
          request.resource.data.phoneVerified == true &&
          request.resource.data.phoneNumber == request.auth.token.get('phone_number', ''));
    }
    match /tenant_codes/{code} {
      // Authenticated users can check a generated code for a collision, but
      // cannot list reservations or inspect tenant account details.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        validTenantCode(code) &&
        request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.createdAt == request.time &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == code;
      allow update, delete: if false;
    }
    match /tenant_contacts/{code} {
      // Landlords can resolve a tenant code to the contact fields needed by a
      // lease form. Tenants can read and maintain only their own directory row.
      allow get: if active() && (
        profile().role in ['admin', 'landlord'] ||
        (profile().role == 'tenant' && profile().tenantId == code)
      );
      allow list: if false;
      allow create: if tenantContactOwner(code) &&
        validTenantContact(request.resource.data);
      allow update: if tenantContactOwner(code) &&
        validTenantContact(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber'
        ]);
      allow delete: if false;
    }
    match /account_requests/{uid} {
      // Legacy signup requests are read once to activate accounts created by
      // older app versions; current signups write users/{uid} directly.
      allow read: if (request.auth != null && uid == request.auth.uid) || admin();
      allow create: if request.auth != null && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'requestedRole', 'status', 'createdAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.requestedRole in ['landlord', 'tenant'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      // Legacy request documents remain immutable; account approval is retired.
      allow update, delete: if false;
    }
    match /app_documents/{id} { allow read, write: if false; }
    match /user_state/{uid} {
      allow read, write: if active() && uid == request.auth.uid &&
        (request.method == 'get' || request.resource.data.keys().hasOnly(['accounts', 'favorites']));
    }
    match /management/{uid} {
      allow read: if admin() || (active() && uid == request.auth.uid);
      allow write: if admin() || (active() && profile().role == 'landlord' && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['staff']));
    }
    match /public_settings/{id} {
      allow read: if true;
      allow write: if admin() && request.resource.data.keys().hasOnly(['acceptingViewings']) && request.resource.data.acceptingViewings is bool;
    }
    match /support_tickets/{id} {
      allow read: if admin() || (active() && resource.data.accountUid == request.auth.uid);
      allow get: if active() && !exists(/databases/$(database)/documents/support_tickets/$(id));
      allow create: if active() && request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.data.role == profile().role && request.resource.data.data.reply == '' && request.resource.data.data.closed == false;
      allow update: if admin() && request.resource.data.accountUid == resource.data.accountUid &&
        request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['reply', 'closed']);
      allow delete: if false;
    }
    match /rental_properties/{id} {
      allow read: if true;
      // Landlord property document IDs are their Firebase UIDs, so a landlord
      // can create only the one property document assigned to their account.
      allow create: if admin() ||
        (request.auth != null && id == request.auth.uid &&
          owner(request.resource.data) &&
          request.resource.data.get('verified', false) == false &&
          request.resource.data.get('verificationProof', '') == '');
      allow update: if admin() || (owner(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.get('verified', false) == resource.data.get('verified', false) &&
        request.resource.data.get('verificationProof', '') == resource.data.get('verificationProof', '') &&
        request.resource.data.get('published', true) == resource.data.get('published', true));
      allow delete: if false;
    }
    match /public_rooms/{id} {
      allow read: if true;
      allow create: if admin() || (ownsProperty(request.resource.data.propertyId) && owner(request.resource.data) &&
        (request.resource.data.published == false ||
          getAfter(/databases/$(database)/documents/rental_properties/$(request.resource.data.propertyId)).data.get('published', true) == true));
      allow update: if admin() || (owner(resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.propertyId == resource.data.propertyId &&
        (request.resource.data.published == resource.data.published || request.resource.data.published == false));
      allow delete: if false;
    }
    match /rental_records/{id} {
      allow read: if admin() || owner(resource.data) || tenant(resource.data);
      allow get: if active() && !exists(/databases/$(database)/documents/rental_records/$(id));
      allow create: if admin() || (owner(request.resource.data) && ownsProperty(request.resource.data.propertyId) &&
        (request.resource.data.kind != 'messages' || landlordMessageCreate())) ||
        (tenant(request.resource.data) && tenantCreate());
      allow update: if admin() || (owner(resource.data) && resource.data.kind != 'messages' &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.kind == resource.data.kind) ||
        (tenant(resource.data) && sameEnvelope() && tenantUpdate());
      allow delete: if false;
      function validTarget() {
        return request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/rental_properties/$(request.resource.data.propertyId)).data.ownerUid &&
          request.resource.data.tenantIds == [profile().tenantId] && request.resource.data.archived == false;
      }
      function ownLease() {
        let leaseId = request.resource.data.data.leaseId;
        // Các mã hợp đồng sinh bởi ứng dụng không chứa dấu '/' hoặc ':'.
        let doc = get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':leases:' + leaseId)).data;
        return tenant(doc) && doc.archived == false && doc.kind == 'leases' && doc.data.status == 'active';
      }
      function tenantCreate() {
        let d = request.resource.data.data;
        return validTarget() && (
          (request.resource.data.kind == 'viewings' && d.tenantId == profile().tenantId && d.status == 'pending' && acceptingViewings()) ||
          (request.resource.data.kind == 'incidents' && d.reporterId == profile().tenantId && d.status == 'newly' && ownLease()) ||
          (request.resource.data.kind == 'members' && d.requestedBy == profile().tenantId && d.status == 'pending' && d.isRepresentative == false && ownLease()) ||
          (request.resource.data.kind == 'conversations' && d.tenantId == profile().tenantId && d.messages == []) ||
          (request.resource.data.kind == 'messages' && messageCreate()) ||
          (request.resource.data.kind == 'payments' && paymentCreate())
        );
      }
      function acceptingViewings() {
        return !exists(/databases/$(database)/documents/public_settings/viewings) ||
          get(/databases/$(database)/documents/public_settings/viewings).data.acceptingViewings == true;
      }
      function landlordMessageCreate() {
        let d = request.resource.data.data;
        let conversation = getAfter(/databases/$(database)/documents/rental_records/$(d.conversationKey)).data;
        return owner(conversation) && conversation.kind == 'conversations' && conversation.archived == false &&
          conversation.propertyId == request.resource.data.propertyId &&
          conversation.tenantIds == request.resource.data.tenantIds && conversation.data.id == d.conversationId &&
          d.fromLandlord == true && d.text is string && d.text.size() > 0 && d.text.size() <= 5000 &&
          d.index is int && d.index >= 0;
      }
      function messageCreate() {
        let d = request.resource.data.data;
        let conversation = getAfter(/databases/$(database)/documents/rental_records/$(d.conversationKey)).data;
        return tenant(conversation) && conversation.kind == 'conversations' && conversation.archived == false &&
          conversation.propertyId == request.resource.data.propertyId &&
          conversation.data.id == d.conversationId &&
          d.fromLandlord == false && d.text is string && d.text.size() > 0 && d.text.size() <= 5000 &&
          d.index is int && d.index >= 0;
      }
      function paymentCreate() {
        let d = request.resource.data.data;
        let invoice = get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':invoices:' + d.invoiceId)).data;
        return tenant(invoice) && invoice.kind == 'invoices' && invoice.archived == false && invoice.data.cancelled == false &&
          invoice.ownerUid == request.resource.data.ownerUid && d.status == 'pending' && d.approvedAmount == null &&
          d.reviewedAt == null && d.reportedAmount is int && d.reportedAmount > 0 &&
          d.reportedAmount <= 1000000000;
      }
      function tenantUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        return
          (resource.data.kind == 'viewings' && changed.hasOnly(['status']) && old.status != 'cancelled' && d.status == 'cancelled') ||
          (resource.data.kind == 'incidents' && changed.hasOnly(['status']) && old.status == 'resolved' && d.status in ['closed', 'newly']) ||
          (resource.data.kind == 'conversations' && conversationUpdate()) ||
          (resource.data.kind == 'tenantAnnouncements' && changed.hasOnly(['readByTenant']) &&
            d.readByTenant.keys().hasOnly([profile().tenantId]) &&
            d.readByTenant[profile().tenantId] is list &&
            d.readByTenant[profile().tenantId].hasOnly(old.recipients.keys()));
      }
      function conversationUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        return changed.hasOnly(['tenantUnread', 'unread']) &&
          (d.tenantUnread == old.tenantUnread || d.tenantUnread == 0) &&
          (d.unread == old.unread || d.unread == old.unread + 1);
      }
    }
  }
}
