rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && profile().disabled == false; }
    function admin() { return active() && profile().role == 'admin'; }
    function owner(data) { return active() && profile().role == 'landlord' && data.ownerUid == request.auth.uid; }
    function tenant(data) { return active() && profile().role == 'tenant' && profile().tenantId in data.tenantIds; }
    function ownsProperty(id) { return owner(getAfter(/databases/$(database)/documents/rental_properties/$(id)).data); }
    function sameEnvelope() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']) &&
        request.resource.data.archived == false;
    }
    function validPhoneContact(data) {
      return (!data.keys().hasAny(['phoneNumber']) ||
          (data.phoneNumber is string && data.phoneNumber.matches('^\\+84[35789][0-9]{8}$'))) &&
        (!data.keys().hasAny(['phoneIsSynthetic']) || data.phoneIsSynthetic == false) &&
        (!data.keys().hasAny(['phoneVerified']) ||
          (data.phoneVerified is bool &&
            (data.phoneVerified == false ||
              data.phoneNumber == request.auth.token.get('phone_number', ''))));
    }
    function tenantContactOwner(code) {
      return active() && profile().role == 'tenant' && profile().tenantId == code;
    }
    function validTenantContact(data) {
      return data.keys().hasOnly(['displayName', 'phoneNumber']) &&
        data.keys().hasAll(['displayName', 'phoneNumber']) &&
        data.displayName == profile().displayName &&
        data.phoneNumber ==
          (profile().keys().hasAny(['phoneNumber']) ? profile().phoneNumber : '');
    }
    function validTenantCode(code) {
      return code is string && code.matches('^[A-Z0-9]{8}$');
    }
    match /users/{uid} {
      // Users can read their own role record to distinguish pending/disabled accounts.
      allow read: if request.auth != null &&
        (uid == request.auth.uid || admin());
      // Users can self-register only as landlord or tenant. Admin can never be
      // assigned by a client; tenant codes are reserved atomically on creation.
      allow create: if request.auth != null && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'disabled', 'tenantId', 'createdAt',
          'phoneNumber', 'phoneVerified', 'phoneIsSynthetic'
        ]) &&
        request.resource.data.keys().hasAll([
          'email', 'displayName', 'role', 'disabled', 'createdAt'
        ]) &&
        request.resource.data.email == request.auth.token.get('email', '') &&
        validPhoneContact(request.resource.data) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.role in ['landlord', 'tenant'] &&
        request.resource.data.disabled == false &&
        request.resource.data.createdAt == request.time &&
        ((request.resource.data.role == 'tenant' &&
            validTenantCode(request.resource.data.tenantId) &&
            !exists(/databases/$(database)/documents/tenant_codes/$(request.resource.data.tenantId)) &&
            existsAfter(/databases/$(database)/documents/tenant_codes/$(request.resource.data.tenantId)) &&
            getAfter(/databases/$(database)/documents/tenant_codes/$(request.resource.data.tenantId)).data.createdAt == request.time) ||
          (request.resource.data.role == 'landlord' &&
            !request.resource.data.keys().hasAny(['tenantId'])));
      allow delete: if false;
      allow update: if (admin() && uid != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']) &&
          request.resource.data.disabled is bool) ||
        (active() && uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phoneNumber', 'phoneVerified', 'phoneIsSynthetic'
          ]) && validPhoneContact(request.resource.data) &&
          request.resource.data.phoneVerified == true &&
          request.resource.data.phoneNumber == request.auth.token.get('phone_number', ''));
    }
    match /users/{uid}/devices/{deviceId} {
      allow read: if request.auth != null && uid == request.auth.uid;
      allow create, update: if request.auth != null && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['token', 'enabled', 'updatedAt']) &&
        request.resource.data.token is string && request.resource.data.enabled is bool;
      allow delete: if request.auth != null && uid == request.auth.uid;
    }
    match /tenant_codes/{code} {
      // Authenticated users can check a generated code for a collision, but
      // cannot list reservations or inspect tenant account details.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        validTenantCode(code) &&
        request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.createdAt == request.time &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == code;
      allow update, delete: if false;
    }
    match /tenant_contacts/{code} {
      // Landlords can resolve a tenant code to contact fields. Tenants can
      // read only their own directory row; listing remains forbidden.
      allow get: if active() && (
        profile().role in ['admin', 'landlord'] ||
        (profile().role == 'tenant' && profile().tenantId == code)
      );
      allow list: if false;
      allow create: if tenantContactOwner(code) &&
        validTenantContact(request.resource.data);
      allow update: if tenantContactOwner(code) &&
        validTenantContact(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber'
        ]);
      allow delete: if false;
    }
    match /account_requests/{uid} {
      // Legacy signup requests are read once to activate accounts created by
      // older app versions; current signups write users/{uid} directly.
      allow read: if (request.auth != null && uid == request.auth.uid) || admin();
      allow create: if request.auth != null && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'requestedRole', 'status', 'createdAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.requestedRole in ['landlord', 'tenant'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      // Legacy request documents remain immutable; account approval is retired.
      allow update, delete: if false;
    }
    match /app_documents/{id} { allow read, write: if false; }
    match /user_state/{uid} {
      allow read, write: if active() && uid == request.auth.uid &&
        (request.method == 'get' || request.resource.data.keys().hasOnly(['accounts', 'favorites']));
    }
    match /management/{uid} {
      allow read: if admin() || (active() && uid == request.auth.uid);
      allow write: if admin() || (active() && profile().role == 'landlord' && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['staff']));
    }
    match /public_settings/subscription_payment {
      allow read: if true;
      // Subscription settings now live in Supabase. Keep this legacy document
      // readable only as a source for the one-time import; never write here.
      allow write: if false;
    }
    match /public_settings/{id} {
      allow read: if true;
      allow write: if admin() && id == 'viewings' &&
        request.resource.data.keys().hasOnly(['acceptingViewings']) &&
        request.resource.data.acceptingViewings is bool;
    }
    match /subscription_orders/{orderId} {
      // Orders moved to Supabase. Preserve legacy reads for the importer and
      // old account history, but prevent new Firestore-only payment records.
      allow read: if admin() ||
        (active() && profile().role == 'landlord' &&
          resource.data.landlordUid == request.auth.uid);
      allow write: if false;
    }
    match /sepay_unmatched_transactions/{transactionId} {
      allow read: if admin();
      allow write: if false;
    }
    match /sepay_transactions/{transactionId} {
      allow read, write: if false;
    }
    match /support_tickets/{id} {
      allow read: if admin() || (active() && resource.data.accountUid == request.auth.uid);
      allow get: if active() && !exists(/databases/$(database)/documents/support_tickets/$(id));
      allow create: if active() && request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.data.role == profile().role && request.resource.data.data.reply == '' && request.resource.data.data.closed == false;
      allow update: if admin() && request.resource.data.accountUid == resource.data.accountUid &&
        request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['reply', 'closed']);
      allow delete: if false;
    }
    match /rental_properties/{id} {
      allow read: if true;
      // A landlord can add properties under their own UID. Keep the document
      // ID aligned with the property ID and leave verification to admin.
      allow create: if admin() ||
        (owner(request.resource.data) &&
          request.resource.data.keys().hasOnly([
            'ownerUid', 'published', 'verified', 'verificationProof', 'data'
          ]) &&
          request.resource.data.keys().hasAll([
            'ownerUid', 'published', 'verified', 'verificationProof', 'data'
          ]) &&
          request.resource.data.published is bool &&
          request.resource.data.verified == false &&
          request.resource.data.verificationProof == '' &&
          request.resource.data.data is map &&
          request.resource.data.data.property is map &&
          request.resource.data.data.property.id == id);
      allow update: if admin() || (owner(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.get('verified', false) == resource.data.get('verified', false) &&
        request.resource.data.get('verificationProof', '') == resource.data.get('verificationProof', '') &&
        request.resource.data.get('published', true) == resource.data.get('published', true));
      allow delete: if false;
    }
    match /public_rooms/{id} {
      allow read: if true;
      allow create: if admin() || (ownsProperty(request.resource.data.propertyId) && owner(request.resource.data) &&
        (request.resource.data.published == false ||
          getAfter(/databases/$(database)/documents/rental_properties/$(request.resource.data.propertyId)).data.get('published', true) == true));
      allow update: if admin() || (owner(resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.propertyId == resource.data.propertyId &&
        (request.resource.data.published == resource.data.published || request.resource.data.published == false));
      allow delete: if false;
    }
    match /rental_records/{id} {
      allow read: if admin() || owner(resource.data) || tenant(resource.data);
      allow get: if active() && !exists(/databases/$(database)/documents/rental_records/$(id));
      allow create: if admin() || (owner(request.resource.data) && ownsProperty(request.resource.data.propertyId) &&
        request.resource.data.kind != 'verificationReview' &&
        (request.resource.data.kind != 'messages' || landlordMessageCreate())) ||
        (tenant(request.resource.data) && tenantCreate());
      allow update: if admin() || (owner(resource.data) && resource.data.kind != 'messages' &&
        resource.data.kind != 'verificationReview' &&
        resource.data.kind != 'payments' &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.kind == resource.data.kind &&
        (resource.data.kind != 'conversations' ||
          (request.resource.data.data.get('ownerUid', resource.data.ownerUid) == resource.data.ownerUid &&
           request.resource.data.data.get('tenantId', '') == resource.data.data.tenantId)) &&
        (resource.data.kind != 'invoices' || ownerInvoiceUpdate())) ||
        (owner(resource.data) && resource.data.kind == 'payments' &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.propertyId == resource.data.propertyId &&
          request.resource.data.kind == resource.data.kind && ownerPaymentUpdate()) ||
        (tenant(resource.data) && sameEnvelope() && tenantUpdate());
      allow delete: if false;
      function validTarget() {
        return request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/rental_properties/$(request.resource.data.propertyId)).data.ownerUid &&
          request.resource.data.tenantIds is list &&
          request.resource.data.tenantIds.hasAny([profile().tenantId]) &&
          request.resource.data.archived == false;
      }
      function ownLease() {
        let leaseId = request.resource.data.data.leaseId;
        // Các mã hợp đồng sinh bởi ứng dụng không chứa dấu '/' hoặc ':'.
        let doc = get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':leases:' + leaseId)).data;
        return tenant(doc) && doc.archived == false && doc.kind == 'leases' && doc.data.status == 'active';
      }
      function tenantCreate() {
        let d = request.resource.data.data;
        return validTarget() && (
          (request.resource.data.kind == 'viewings' && request.resource.data.tenantIds == [profile().tenantId] && d.tenantId == profile().tenantId && d.status == 'pending' && acceptingViewings()) ||
          (request.resource.data.kind == 'incidents' && d.reporterId == profile().tenantId && d.status == 'newly' && ownLease() && request.resource.data.tenantIds.hasOnly(get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':leases:' + d.leaseId)).data.tenantIds)) ||
          (request.resource.data.kind == 'members' && d.requestedBy == profile().tenantId && d.status == 'pending' && d.isRepresentative == false && validTenantCode(d.tenantId) && d.tenantId != profile().tenantId && exists(/databases/$(database)/documents/tenant_codes/$(d.tenantId)) && ownLease() && get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':leases:' + d.leaseId)).data.data.tenantId == profile().tenantId && request.resource.data.tenantIds.hasOnly(get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':leases:' + d.leaseId)).data.tenantIds)) ||
          (request.resource.data.kind == 'conversations' && tenantConversationCreate(d)) ||
          (request.resource.data.kind == 'messages' && messageCreate()) ||
          (request.resource.data.kind == 'payments' && paymentCreate())
        );
      }
      function tenantConversationCreate(d) {
        let context = d.get('lastRoomContext', null);
        let contexts = d.get('roomContexts', []);
        let noContext = context == null && contexts.size() == 0;
        let oneContext = context is map && contexts.size() == 1 &&
          contexts[0] == context &&
          context.propertyId == request.resource.data.propertyId &&
          context.roomId is string && context.roomName is string &&
          context.propertyName is string;
        return request.resource.data.tenantIds == [profile().tenantId] &&
          d.tenantId == profile().tenantId &&
          d.ownerUid == request.resource.data.ownerUid && d.messages == [] &&
          contexts is list && (noContext || oneContext);
      }
      function acceptingViewings() {
        return !exists(/databases/$(database)/documents/public_settings/viewings) ||
          get(/databases/$(database)/documents/public_settings/viewings).data.acceptingViewings == true;
      }
      function landlordMessageCreate() {
        let d = request.resource.data.data;
        let conversation = getAfter(/databases/$(database)/documents/rental_records/$(d.conversationKey)).data;
        return owner(conversation) && conversation.kind == 'conversations' && conversation.archived == false &&
          conversation.propertyId == request.resource.data.propertyId &&
          conversation.tenantIds == request.resource.data.tenantIds && conversation.data.id == d.conversationId &&
          d.fromLandlord == true && d.text is string && d.text.size() > 0 && d.text.size() <= 5000 &&
          d.index is int && d.index >= 0 && validRoomContext(d, conversation);
      }
      function messageCreate() {
        let d = request.resource.data.data;
        let conversation = getAfter(/databases/$(database)/documents/rental_records/$(d.conversationKey)).data;
        return tenant(conversation) && conversation.kind == 'conversations' && conversation.archived == false &&
          conversation.propertyId == request.resource.data.propertyId &&
          conversation.data.id == d.conversationId &&
          d.fromLandlord == false && d.text is string && d.text.size() > 0 && d.text.size() <= 5000 &&
          d.index is int && d.index >= 0 && validRoomContext(d, conversation);
      }
      function validRoomContext(message, conversation) {
        let context = message.get('roomContext', null);
        return context == null || (context is map &&
          context.keys().hasOnly(['propertyId', 'roomId', 'roomName', 'propertyName', 'source']) &&
          context.propertyId is string && context.propertyId.size() > 0 &&
          context.roomId is string && context.roomId.size() > 0 &&
          context.roomName is string && context.roomName.size() > 0 &&
          get(/databases/$(database)/documents/rental_properties/$(context.propertyId)).data.ownerUid == conversation.ownerUid);
      }
      function paymentCreate() {
        let d = request.resource.data.data;
        let invoice = get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':invoices:' + d.invoiceId)).data;
        let lease = get(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':leases:' + invoice.data.leaseId)).data;
        let invoiceAfter = getAfter(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':invoices:' + d.invoiceId)).data;
        return tenant(invoice) && invoice.kind == 'invoices' && invoice.archived == false && invoice.data.cancelled == false &&
          request.resource.data.tenantIds.hasOnly(invoice.tenantIds) &&
          invoice.ownerUid == request.resource.data.ownerUid && d.status == 'pending' && d.approvedAmount == null &&
          d.reviewedAt == null && d.reportedAmount is int && d.reportedAmount > 0 &&
          d.id is string && invoiceAfter.data.get('pendingPaymentId', null) == d.id &&
          lease.kind == 'leases' && lease.data.status == 'active' && tenant(lease) &&
          ((d.method == 'Tiền mặt' && lease.data.cashPaymentEnabled == true &&
              d.reference == '' && d.proofUrl == null) ||
            (d.method == 'Chuyển khoản' && lease.data.bankTransferEnabled == true &&
              d.reference is string && d.reference.size() > 0)) &&
          d.reportedAmount <= 1000000000;
      }
      function tenantUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        return
          (resource.data.kind == 'viewings' && changed.hasOnly(['status']) && old.status != 'cancelled' && d.status == 'cancelled') ||
          (resource.data.kind == 'incidents' && changed.hasOnly(['status']) && old.status == 'resolved' && d.status in ['closed', 'newly']) ||
          (resource.data.kind == 'leases' && leaseRequestUpdate()) ||
          (resource.data.kind == 'invoices' && invoicePaymentLockUpdate()) ||
          (resource.data.kind == 'payments' && paymentCancelUpdate()) ||
          (resource.data.kind == 'conversations' && conversationUpdate()) ||
          (resource.data.kind == 'members' && memberIdentityUpdate()) ||
          (resource.data.kind == 'tenantAnnouncements' && changed.hasOnly(['readByTenant']) &&
            d.readByTenant.keys().hasOnly([profile().tenantId]) &&
            d.readByTenant[profile().tenantId] is list &&
            d.readByTenant[profile().tenantId].hasOnly(old.recipients.keys()));
      }
      function memberIdentityUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        let identityUpdate = changed.hasOnly(['identityFrontPath', 'identityBackPath', 'portraitPath']);
        let leaveUpdate = changed.hasOnly([
          'leaveReason', 'leaveRequestedAt', 'leaveEffectiveAt', 'leaveAcknowledgedAt'
        ]) &&
          changed.hasAll(['leaveReason', 'leaveRequestedAt', 'leaveEffectiveAt']) &&
          old.get('isRepresentative', true) == false && d.isRepresentative == false &&
          d.leaveReason is string && d.leaveReason.size() <= 300 &&
          d.leaveRequestedAt is string && d.leaveEffectiveAt is string &&
          d.leaveAcknowledgedAt == null;
        return (identityUpdate || leaveUpdate) &&
          old.status == 'active' && d.status == 'active' &&
          old.tenantId == profile().tenantId && d.tenantId == profile().tenantId;
      }
      function leaseRequestUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        let terminationFields = [
          'terminationRequestStatus', 'terminationRequestedAt',
          'terminationRequestedBy', 'terminationRequestReason',
          'terminationReviewedAt', 'terminationRejectionReason'
        ];
        let renewalFields = [
          'renewalStatus', 'renewalRequestedAt', 'renewalRequestedBy',
          'renewalProposedEndDate', 'renewalReason', 'renewalReviewedAt',
          'renewalRejectionReason'
        ];
        let terminationRequest = changed.hasOnly(terminationFields) &&
          d.terminationRequestStatus == 'pending' &&
          old.get('terminationRequestStatus', '') != 'pending' &&
          old.get('renewalStatus', '') != 'pending' &&
          d.terminationRequestedBy == profile().tenantId &&
          d.terminationRequestedAt is string &&
          d.terminationRequestReason is string &&
          d.terminationRequestReason.size() >= 5 &&
          d.terminationRequestReason.size() <= 300;
        let renewalRequest = changed.hasOnly(renewalFields) &&
          d.renewalStatus == 'pending' && old.get('renewalStatus', '') != 'pending' &&
          old.get('terminationRequestStatus', '') != 'pending' &&
          d.renewalRequestedBy == profile().tenantId &&
          d.renewalRequestedAt is string &&
          d.renewalProposedEndDate is string &&
          d.renewalReason is string && d.renewalReason.size() <= 300;
        return old.status == 'active' && d.status == 'active' &&
          old.tenantId == profile().tenantId && d.tenantId == old.tenantId &&
          (terminationRequest || renewalRequest);
      }
      function conversationUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        return changed.hasOnly(['tenantUnread', 'unread']) &&
          (d.tenantUnread == old.tenantUnread || d.tenantUnread == 0) &&
          (d.unread == old.unread || d.unread == old.unread + 1);
      }
      function invoicePaymentLockUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        let createPayment = getAfter(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':payments:' + d.pendingPaymentId)).data;
        let cancelPayment = getAfter(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':payments:' + old.pendingPaymentId)).data;
        return changed.hasOnly(['pendingPaymentId']) &&
          ((old.get('pendingPaymentId', null) == null && d.pendingPaymentId is string &&
              createPayment.kind == 'payments' && createPayment.data.id == d.pendingPaymentId &&
              createPayment.data.invoiceId == d.id && createPayment.data.status == 'pending' && tenant(createPayment)) ||
            (old.pendingPaymentId is string && d.get('pendingPaymentId', null) == null &&
              cancelPayment.kind == 'payments' && cancelPayment.data.id == old.pendingPaymentId &&
              cancelPayment.data.invoiceId == d.id && cancelPayment.data.status == 'cancelled' &&
              tenant(cancelPayment)));
      }
      function paymentCancelUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        let invoiceAfter = getAfter(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':invoices:' + d.invoiceId)).data;
        return changed.hasOnly(['status', 'reviewedAt']) && old.status == 'pending' &&
          d.status == 'cancelled' && d.reviewedAt is string &&
          d.invoiceId == old.invoiceId && d.reportedAmount == old.reportedAmount &&
          d.approvedAmount == old.approvedAmount && invoiceAfter.data.get('pendingPaymentId', null) == null;
      }
      function ownerPaymentUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        let invoicePath = /databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':invoices:' + d.invoiceId);
        let invoiceBefore = get(invoicePath).data;
        let invoiceAfter = getAfter(invoicePath).data;
        let approved = d.status == 'approved' && d.approvedAmount is int &&
          d.approvedAmount > 0 && d.approvedAmount <= old.reportedAmount &&
          d.reviewedAt is string && invoiceAfter.data.paidAmount == invoiceBefore.data.paidAmount + d.approvedAmount &&
          invoiceAfter.data.get('lastApprovedPaymentId', null) == d.id &&
          invoiceAfter.data.get('pendingPaymentId', null) == null &&
          invoiceAfter.data.paidAmount == invoiceBefore.data.paidAmount + d.approvedAmount;
        let rejected = d.status == 'rejected' && d.approvedAmount == null &&
          d.rejectionReason is string && d.rejectionReason.size() > 0 &&
          d.reviewedAt is string && invoiceAfter.data.paidAmount == invoiceBefore.data.paidAmount &&
          invoiceAfter.data.get('pendingPaymentId', null) == null &&
          invoiceAfter.data.get('lastApprovedPaymentId', null) == invoiceBefore.data.get('lastApprovedPaymentId', null);
        return old.status == 'pending' && changed.hasOnly([
            'status', 'approvedAmount', 'reviewedAt', 'rejectionReason'
          ]) && d.invoiceId == old.invoiceId && d.reportedAmount == old.reportedAmount &&
          d.method == old.method && d.reference == old.reference && (approved || rejected);
      }
      function ownerInvoiceUpdate() {
        let d = request.resource.data.data;
        let old = resource.data.data;
        let changed = d.diff(old).affectedKeys();
        let financialChanged = changed.hasAny(['paidAmount', 'pendingPaymentId', 'lastApprovedPaymentId']);
        return !financialChanged || ownerInvoiceApprovedUpdate(d, old) ||
          ownerInvoiceResolvedUpdate(d, old);
      }
      function ownerInvoiceApprovedUpdate(d, old) {
        let paymentId = d.get('lastApprovedPaymentId', null);
        let paymentPath = /databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':payments:' + paymentId);
        let payment = paymentId is string
          ? getAfter(paymentPath).data
          : {};
        let paymentBefore = paymentId is string ? get(paymentPath).data : {};
        return paymentId is string && payment.kind == 'payments' &&
          payment.data.id == paymentId && payment.data.invoiceId == d.id &&
          payment.data.status == 'approved' &&
          payment.data.approvedAmount == d.paidAmount - old.paidAmount &&
          old.get('lastApprovedPaymentId', null) != paymentId &&
          (old.get('pendingPaymentId', null) == paymentId ||
            (old.get('pendingPaymentId', null) == null &&
              paymentBefore.kind == 'payments' && paymentBefore.data.status == 'pending')) &&
          d.get('pendingPaymentId', null) == null;
      }
      function ownerInvoiceResolvedUpdate(d, old) {
        let pendingId = old.get('pendingPaymentId', null);
        let payment = pendingId is string
          ? getAfter(/databases/$(database)/documents/rental_records/$(request.resource.data.propertyId + ':payments:' + pendingId)).data
          : {};
        return pendingId is string && d.get('pendingPaymentId', null) == null &&
          payment.kind == 'payments' && payment.data.id == pendingId &&
          payment.data.invoiceId == d.id &&
          payment.data.status in ['approved', 'rejected'] &&
          (payment.data.status == 'approved'
            ? d.get('lastApprovedPaymentId', null) == pendingId &&
              d.paidAmount == old.paidAmount + payment.data.approvedAmount
            : d.paidAmount == old.paidAmount &&
              d.get('lastApprovedPaymentId', null) == old.get('lastApprovedPaymentId', null));
      }
    }
  }
}
